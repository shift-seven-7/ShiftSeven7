{
  "name": "sass-infra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env USE_LOCAL_DB=true NEXT_PUBLIC_USE_LOCAL_DB=true next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status -o env",
    "db:reset": "supabase db reset && npm run db:migrate:master && npm run db:seed",
    "db:migrate": "supabase db push --local",
    "db:migrate:master": "cross-env USE_LOCAL_DB=true npx tsx scripts/sync-master-migrations.ts",
    "db:seed": "cross-env USE_LOCAL_DB=true npx tsx scripts/seed-local-tenants.ts",
    "db:init": "npm run db:start && npm run db:migrate && npm run db:migrate:master && npm run db:seed",
    "tenant:bootstrap": "npx tsx scripts/bootstrap-tenant.ts",
    "secrets:generate-key": "npx tsx scripts/generate-secrets-key.ts",
    "secrets:encrypt": "npx tsx scripts/encrypt-tenant-secrets.ts",
    "secrets:rotate": "npx tsx scripts/rotate-tenant-secrets-key.ts",
    "sync-master-migrations": "npx tsx scripts/sync-master-migrations.ts",
    "sync-tenant-migrations": "npx tsx scripts/sync-tenant-migrations.ts",
    "sync-all-tenants-migrations": "npx tsx scripts/sync-tenant-migrations.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@tanstack/react-query": "^5.90.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "pg": "^8.23.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
