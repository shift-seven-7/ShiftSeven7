# =============================================================================
# MASTER REGISTRY — the Supabase project that holds the `tenants` table.
# Server-side only. Never expose these.
# =============================================================================
MASTER_SUPABASE_URL=
MASTER_SUPABASE_SERVICE_KEY=
# Publishable/anon key of the SAME project. Only the backoffice sign-in uses it:
# platform operators authenticate against the master project, which is what lets
# /backoffice work on hosts where no tenant resolves. Without it /backoffice says
# it is not configured; everything else keeps working.
MASTER_SUPABASE_ANON_KEY=

# =============================================================================
# SECRET WRAPPING — AES-256-GCM key for the tenant Supabase keys at rest.
# Generate with: npm run secrets:generate-key
# Losing this key makes every stored tenant credential unreadable.
# =============================================================================
TENANT_SECRETS_KEY=
# Only set during a key rotation; unset it once `npm run secrets:rotate` finishes.
TENANT_SECRETS_KEY_PREVIOUS=

# =============================================================================
# DOMAIN
# =============================================================================
# The apex the app serves tenants under. A tenant at subdomain "acme" is
# reachable at acme.<NEXT_PUBLIC_BASE_DOMAIN>.
NEXT_PUBLIC_BASE_DOMAIN=example.app
# Which tenant *.vercel.app preview deployments resolve to.
# Leave empty and previews land on /tenant-not-found (the safe default).
DEFAULT_PREVIEW_TENANT=

# =============================================================================
# SIGN-IN METHODS
# Comma-separated, from: password, google, email_otp, phone_otp.
# Defaults to `password` when unset.
#
# This is the deployment-wide choice. It decides what the login screen renders,
# what /api/auth/<method>/* accepts, and which providers a newly provisioned
# tenant project gets configured with.
#
# `email_otp` and `phone_otp` ship as placeholders: enabling one renders it and
# answers 501 with instructions until it is implemented.
# See docs/features/auth-methods.md
# =============================================================================
NEXT_PUBLIC_AUTH_METHODS=password

# Platform operators — comma-separated emails allowed to manage the tenant
# registry, from /backoffice or from /app/admin/tenants.
#
# At /backoffice this is the ONLY authorization: the master project has no roles,
# and Google will mint a session for any address, so an empty list admits NOBODY
# there. In the in-tenant console an empty list falls back to the ADMIN role,
# which is the pre-existing behaviour and tolerable for one customer.
PLATFORM_OPERATOR_EMAILS=

# First-run setup. Set this to open /bootstrap, which creates the FIRST tenant
# without an account — the console cannot, because it lives inside a tenant.
# The route needs BOTH this token and an empty registry, and closes itself once
# a tenant exists. Unset = the route does not exist at all.
# Generate one with: openssl rand -base64 24
# REMOVE IT once the first tenant is up.
BOOTSTRAP_TOKEN=

# =============================================================================
# TENANT PROVISIONING (optional — only needed for the automated setup path)
# =============================================================================
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_ORG_ID=
SUPABASE_DEFAULT_REGION=eu-central-1

VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# The CNAME target for tenant subdomains — copy from your Vercel project's
# domain settings. Required by the "domain_added" setup step.
VERCEL_DNS_TARGET=

# Google OAuth, applied to each newly provisioned tenant project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# LOCAL DEVELOPMENT
# When USE_LOCAL_DB=true the local Supabase stack acts as BOTH the master
# registry and the single tenant, so you can work without any cloud project.
# =============================================================================
USE_LOCAL_DB=true
NEXT_PUBLIC_USE_LOCAL_DB=true
LOCAL_TENANT_SUBDOMAIN=local
LOCAL_TENANT_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_TENANT_SUPABASE_ANON_KEY=
LOCAL_TENANT_SUPABASE_SERVICE_KEY=
