{
  "name": "ShiftAssignment",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Staff member ID"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name (denormalized for display)"
    },
    "shift_template_id": {
      "type": "string",
      "description": "Shift template ID"
    },
    "shift_code": {
      "type": "string",
      "description": "Shift code (denormalized)"
    },
    "post_id": {
      "type": "string",
      "description": "Post ID"
    },
    "post_name": {
      "type": "string",
      "description": "Post name (denormalized)"
    },
    "facility_id": {
      "type": "string",
      "description": "Facility ID"
    },
    "date": {
      "type": "string",
      "description": "Assignment date (YYYY-MM-DD)"
    },
    "actual_start": {
      "type": "string",
      "description": "Actual start datetime (ISO format)"
    },
    "actual_end": {
      "type": "string",
      "description": "Actual end datetime (ISO format)"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "scheduled"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "Whether this assignment has been published for staff to view"
    },
    "is_emergency_override": {
      "type": "boolean",
      "default": false
    },
    "override_reason": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    }
  },
  "required": [
    "staff_id",
    "staff_name",
    "shift_template_id",
    "shift_code",
    "post_id",
    "date",
    "actual_start",
    "actual_end",
    "facility_id"
  ]
}