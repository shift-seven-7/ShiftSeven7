{
  "name": "Post",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Post name"
    },
    "code": {
      "type": "string",
      "description": "Short code for the post"
    },
    "type": {
      "type": "string",
      "enum": [
        "static",
        "control_room"
      ],
      "description": "Post type"
    },
    "facility": {
      "type": "string",
      "description": "Facility ID this post belongs to"
    },
    "required_role": {
      "type": "string",
      "enum": [
        "guard",
        "dispatcher"
      ],
      "description": "Role required for this post"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "code",
    "type",
    "facility",
    "required_role"
  ]
}