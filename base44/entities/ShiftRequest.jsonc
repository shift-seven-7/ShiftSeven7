{
  "name": "ShiftRequest",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Staff member ID"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name (denormalized)"
    },
    "facility_id": {
      "type": "string",
      "description": "Facility ID"
    },
    "week_start": {
      "type": "string",
      "description": "Sunday date of the target week (YYYY-MM-DD)"
    },
    "date": {
      "type": "string",
      "description": "Specific date for this request (YYYY-MM-DD)"
    },
    "shift_template_id": {
      "type": "string",
      "description": "Requested shift template ID"
    },
    "shift_code": {
      "type": "string",
      "description": "Shift code (denormalized)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted"
      ],
      "default": "draft",
      "description": "draft = saved, submitted = sent to management"
    }
  },
  "required": [
    "staff_id",
    "staff_name",
    "facility_id",
    "week_start",
    "date",
    "shift_template_id",
    "shift_code"
  ]
}