{
  "name": "ShiftTemplate",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Shift code (1-3 letters + optional number)"
    },
    "name": {
      "type": "string",
      "description": "Descriptive name"
    },
    "category": {
      "type": "string",
      "enum": [
        "morning",
        "afternoon",
        "night"
      ]
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "duration_hours": {
      "type": "number"
    },
    "post_number": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e2\u05de\u05d3\u05d4"
    },
    "color": {
      "type": "string",
      "description": "Hex color for this shift (e.g. #FFD700)"
    },
    "applicable_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facility": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name",
    "category",
    "start_time",
    "end_time",
    "duration_hours",
    "applicable_roles"
  ]
}