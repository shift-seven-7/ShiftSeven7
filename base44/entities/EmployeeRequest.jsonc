{
  "name": "EmployeeRequest",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Staff member ID"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name (denormalized for display)"
    },
    "type": {
      "type": "string",
      "enum": [
        "vacation",
        "sick_leave",
        "reserve_duty",
        "weapon_license",
        "health",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d1\u05e7\u05e9\u05d4: vacation=\u05d7\u05d5\u05e4\u05e9\u05d4, sick_leave=\u05de\u05d7\u05dc\u05d4, reserve_duty=\u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05dd, weapon_license=\u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05e0\u05e9\u05e7, health=\u05e6\u05e8\u05d5\u05ea \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea, other=\u05d0\u05d7\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d8\u05d9\u05e4\u05d5\u05dc: pending=\u05de\u05de\u05ea\u05d9\u05e0\u05d4, approved=\u05d0\u05d5\u05e9\u05e8\u05d4, rejected=\u05e0\u05d3\u05d7\u05ea\u05d4"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4 (\u05d7\u05d5\u05e4\u05e9\u05d4/\u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05dd)"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd"
    },
    "file_url": {
      "type": "string",
      "description": "URL \u05dc\u05e7\u05d5\u05d1\u05e5 \u05e9\u05d4\u05d5\u05e2\u05dc\u05d4 (PDF/\u05ea\u05de\u05d5\u05e0\u05d4)"
    },
    "file_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d4\u05e2\u05d5\u05d1\u05d3 / \u05e1\u05d9\u05d1\u05d4"
    },
    "manager_comment": {
      "type": "string",
      "description": "\u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05de\u05e0\u05d4\u05dc"
    },
    "handled_by": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e0\u05d4\u05dc \u05e9\u05d8\u05d9\u05e4\u05dc \u05d1\u05d1\u05e7\u05e9\u05d4"
    }
  },
  "required": [
    "staff_id",
    "staff_name",
    "type"
  ]
}