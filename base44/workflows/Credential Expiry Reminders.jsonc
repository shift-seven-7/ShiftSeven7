{
  "description": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d9\u05d5\u05de\u05d9\u05ea \u05e9\u05dc \u05ea\u05d5\u05e7\u05e4\u05d9 \u05d0\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd (\u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05e0\u05e9\u05e7, \u05e8\u05e2\u05e0\u05d5\u05df, \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9) \u05d5\u05e9\u05dc\u05d9\u05d7\u05ea \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05d1\u05de\u05d9\u05d9\u05dc \u05dc\u05e2\u05d5\u05d1\u05d3\u05d9\u05dd \u05e9\u05ea\u05d5\u05e7\u05e3 \u05de\u05ea\u05e7\u05e8\u05d1 \u05dc\u05e4\u05d5\u05d2 \u05d0\u05d5 \u05e4\u05d2",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "credential_expiry_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_expiries": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkCredentialExpiries"
          },
          "then": "end",
          "x-base44": {
            "title": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05ea\u05d5\u05e7\u05e4\u05d9\u05dd \u05d5\u05e9\u05dc\u05d9\u05d7\u05ea \u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea",
            "description": "\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d9\u05d5\u05de\u05d9\u05ea \u05e9\u05dc \u05db\u05dc \u05d4\u05e2\u05d5\u05d1\u05d3\u05d9\u05dd"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "\u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05ea\u05d5\u05e7\u05e3 \u05d0\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd"
}