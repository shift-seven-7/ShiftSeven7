# Copy to .env.local and fill in from the Supabase project dashboard
# (Project Settings > API). Never commit .env.local.

# Public - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only - bypasses RLS, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Slack incoming webhook, bound to the notifications channel (see docs/MIGRATION_PLAN.md B.5)
SLACK_WEBHOOK_URL=

# Resend (credential-expiry emails)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` -
# protects the credential-expiry cron route from public invocation.
CRON_SECRET=
